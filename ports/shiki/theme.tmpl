{
  "name": "{meta:theme}",
  "displayName": "{meta:theme_title}",
  "type": "{meta:appearance}",
  "fg": "{color:fg-main}",
  "bg": "{color:bg-main}",
  "colors": {
    "editor.foreground": "{color:fg-main}",
    "editor.background": "{color:bg-main}",
    "terminal.ansiBlack": "{color:fg-term-black}",
    "terminal.ansiRed": "{color:fg-term-red}",
    "terminal.ansiGreen": "{color:fg-term-green}",
    "terminal.ansiYellow": "{color:fg-term-yellow}",
    "terminal.ansiBlue": "{color:fg-term-blue}",
    "terminal.ansiMagenta": "{color:fg-term-magenta}",
    "terminal.ansiCyan": "{color:fg-term-cyan}",
    "terminal.ansiWhite": "{color:fg-term-white}",
    "terminal.ansiBrightBlack": "{color:fg-term-black-bright}",
    "terminal.ansiBrightRed": "{color:fg-term-red-bright}",
    "terminal.ansiBrightGreen": "{color:fg-term-green-bright}",
    "terminal.ansiBrightYellow": "{color:fg-term-yellow-bright}",
    "terminal.ansiBrightBlue": "{color:fg-term-blue-bright}",
    "terminal.ansiBrightMagenta": "{color:fg-term-magenta-bright}",
    "terminal.ansiBrightCyan": "{color:fg-term-cyan-bright}",
    "terminal.ansiBrightWhite": "{color:fg-term-white-bright}"
  },
  "tokenColors": [
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {
        "foreground": "{color:punctuation}"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "{color:comment}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "{color:docstring}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment annotations",
      "scope": [
        "comment keyword.codetag.notation",
        "comment keyword.documentation"
      ],
      "settings": {
        "foreground": "{color:prose-todo}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "{color:string}"
      }
    },
    {
      "name": "String escapes and placeholders",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "{color:rx-backslash}"
      }
    },
    {
      "name": "Regular expression constructs",
      "scope": [
        "keyword.control.anchor.regexp",
        "keyword.operator.quantifier.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "{color:rx-construct}"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "{color:number}"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.other",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "{color:constant}"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "{color:keyword}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "{color:operator}"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "{color:preprocessor}"
      }
    },
    {
      "name": "Built-ins",
      "scope": [
        "support.constant",
        "support.function.builtin",
        "support.type.primitive",
        "support.variable",
        "variable.language"
      ],
      "settings": {
        "foreground": "{color:builtin}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function",
        "entity.name.function.preprocessor",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "{color:fnname}"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call variable.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "{color:fnname-call}"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "{color:variable-use}"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "{color:variable}"
      }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.property-name",
        "support.type.property-name",
        "variable.object.property",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "{color:property}"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.class",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "{color:type}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.module",
        "entity.name.namespace",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "{color:identifier}"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "meta.annotation",
        "meta.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "{color:builtin}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "{color:fnname}"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "{color:fg-heading-0}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 1",
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "{color:fg-heading-1}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 2",
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "{color:fg-heading-2}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 3",
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "{color:fg-heading-3}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 4",
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "{color:fg-heading-4}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 5",
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "{color:fg-heading-5}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 6",
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "{color:fg-heading-6}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "{color:fg-main}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "{color:fg-main}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "{color:fg-link}",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "{color:fg-prose-code}"
      }
    },
    {
      "name": "Markup quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "{color:fg-alt}"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "{color:fg-added-intense}"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "{color:fg-removed-intense}"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "{color:fg-changed-intense}"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "{color:err}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "{color:warning}",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
