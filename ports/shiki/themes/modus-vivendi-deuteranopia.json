{
  "name": "modus-vivendi-deuteranopia",
  "displayName": "Modus Vivendi Deuteranopia",
  "type": "dark",
  "fg": "#ffffff",
  "bg": "#000000",
  "colors": {
    "editor.foreground": "#ffffff",
    "editor.background": "#000000",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#ff5f59",
    "terminal.ansiGreen": "#44bc44",
    "terminal.ansiYellow": "#cabf00",
    "terminal.ansiBlue": "#2fafff",
    "terminal.ansiMagenta": "#feacd0",
    "terminal.ansiCyan": "#00d3d0",
    "terminal.ansiWhite": "#a6a6a6",
    "terminal.ansiBrightBlack": "#595959",
    "terminal.ansiBrightRed": "#ff6b55",
    "terminal.ansiBrightGreen": "#00c06f",
    "terminal.ansiBrightYellow": "#ffa00f",
    "terminal.ansiBrightBlue": "#79a8ff",
    "terminal.ansiBrightMagenta": "#b6a0ff",
    "terminal.ansiBrightCyan": "#6ae4b9",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#d8af7a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#9ac8e0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment annotations",
      "scope": [
        "comment keyword.codetag.notation",
        "comment keyword.documentation"
      ],
      "settings": {
        "foreground": "#ffa00f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#79a8ff"
      }
    },
    {
      "name": "String escapes and placeholders",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#00bcff"
      }
    },
    {
      "name": "Regular expression constructs",
      "scope": [
        "keyword.control.anchor.regexp",
        "keyword.operator.quantifier.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#d8af7a"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.other",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#82b0ec"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#00bcff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#b6a0ff"
      }
    },
    {
      "name": "Built-ins",
      "scope": [
        "support.constant",
        "support.function.builtin",
        "support.type.primitive",
        "support.variable",
        "variable.language"
      ],
      "settings": {
        "foreground": "#cabf00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function",
        "entity.name.function.preprocessor",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#ffa00f"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call variable.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#c0965b"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#76afbf"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#00d3d0"
      }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.property-name",
        "support.type.property-name",
        "variable.object.property",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#00d3d0"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.class",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#6ae4b9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.module",
        "entity.name.namespace",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#d2b580"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "meta.annotation",
        "meta.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#cabf00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ffa00f"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#6ae4b9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 1",
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 2",
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#d2b580",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 3",
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#82b0ec",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 4",
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#88ca9f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 5",
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#b6a0ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 6",
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#d8af7a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#79a8ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#6ae4b9"
      }
    },
    {
      "name": "Markup quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#c6daff"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8080ff"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#d0b05f"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#cf9fe2"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ffa00f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#cabf00",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
