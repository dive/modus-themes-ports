{
  "name": "modus-operandi-tinted",
  "displayName": "Modus Operandi Tinted",
  "type": "light",
  "fg": "#000000",
  "bg": "#fbf7f0",
  "colors": {
    "editor.foreground": "#000000",
    "editor.background": "#fbf7f0",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#a60000",
    "terminal.ansiGreen": "#006300",
    "terminal.ansiYellow": "#6d5000",
    "terminal.ansiBlue": "#0031a9",
    "terminal.ansiMagenta": "#721045",
    "terminal.ansiCyan": "#00598b",
    "terminal.ansiWhite": "#a6a6a6",
    "terminal.ansiBrightBlack": "#595959",
    "terminal.ansiBrightRed": "#972500",
    "terminal.ansiBrightGreen": "#00603f",
    "terminal.ansiBrightYellow": "#894000",
    "terminal.ansiBrightBlue": "#3546c2",
    "terminal.ansiBrightMagenta": "#531ab6",
    "terminal.ansiBrightCyan": "#005f5f",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7f0000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comments",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#304463",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment annotations",
      "scope": [
        "comment keyword.codetag.notation",
        "comment keyword.documentation"
      ],
      "settings": {
        "foreground": "#a60000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#00598b"
      }
    },
    {
      "name": "String escapes and placeholders",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.interpolated punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#8f0075"
      }
    },
    {
      "name": "Regular expression constructs",
      "scope": [
        "keyword.control.anchor.regexp",
        "keyword.operator.quantifier.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#531ab6"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.other",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#531ab6"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#0031a9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#894000"
      }
    },
    {
      "name": "Built-ins",
      "scope": [
        "support.constant",
        "support.function.builtin",
        "support.type.primitive",
        "support.variable",
        "variable.language"
      ],
      "settings": {
        "foreground": "#721045",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function",
        "entity.name.function.preprocessor",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#602938"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call variable.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7b435c"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#2a5045"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#00603f"
      }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.property-name",
        "support.type.property-name",
        "variable.object.property",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#00603f"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.class",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#306010",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.module",
        "entity.name.namespace",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#574316"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "meta.annotation",
        "meta.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#721045",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#602938"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#00603f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 1",
      "scope": [
        "markup.heading.1"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 2",
      "scope": [
        "markup.heading.2"
      ],
      "settings": {
        "foreground": "#574316",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 3",
      "scope": [
        "markup.heading.3"
      ],
      "settings": {
        "foreground": "#193668",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 4",
      "scope": [
        "markup.heading.4"
      ],
      "settings": {
        "foreground": "#721045",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 5",
      "scope": [
        "markup.heading.5"
      ],
      "settings": {
        "foreground": "#2a5045",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup heading level 6",
      "scope": [
        "markup.heading.6"
      ],
      "settings": {
        "foreground": "#7f0000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#3546c2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#00603f"
      }
    },
    {
      "name": "Markup quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#193668"
      }
    },
    {
      "name": "Markup inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#006700"
      }
    },
    {
      "name": "Markup deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#aa2222"
      }
    },
    {
      "name": "Markup changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#655000"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a60000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#6d5000",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
