  "tokenColors": [
    {
      "name": "Base text and variables",
      "scope": [
        "source",
        "text",
        "variable.other.readwrite",
        "punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "{color:fg-main}"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {
        "foreground": "{color:fg-main}"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "{color:fg-dim}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "{color:blue-warmer}"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp.character-class",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "{color:magenta}"
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.false",
        "constant.language.true",
        "keyword.other.unit",
        "keyword.other.unit.user-defined",
        "keyword.other.unit.suffix.floating-point"
      ],
      "settings": {
        "foreground": "{color:fg-main}"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "{color:blue-cooler}"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.word",
        "keyword.operator.new",
        "variable.language.super",
        "support.type.primitive",
        "storage.type",
        "storage.modifier",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "{color:magenta-cooler}"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "{color:fg-main}"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call.method",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "{color:magenta}"
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "meta.function-call.constructor",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union"
      ],
      "settings": {
        "foreground": "{color:cyan-cooler}"
      }
    },
    {
      "name": "Types",
      "scope": [
        "meta.type",
        "meta.type-alias",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "{color:cyan-cooler}"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "meta.enum variable.other.readwrite",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "{color:cyan-warmer}"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "meta.property.object",
        "support.type.property-name",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "{color:cyan}"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "{color:blue-cooler}"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "{color:red-warmer}"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.this punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "{color:red-faint}"
      }
    },
    {
      "name": "Builtins and language constants",
      "scope": [
        "support.function.builtin",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "{color:red-faint}"
      }
    },
    {
      "name": "Template string variables",
      "scope": [
        "string.template variable",
        "string variable"
      ],
      "settings": {
        "foreground": "{color:fg-main}"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.decorator",
        "punctuation.definition.annotation",
        "meta.annotation variable.function",
        "meta.annotation variable.annotation.function",
        "meta.annotation punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "{color:yellow-warmer}"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "{color:yellow}"
      }
    },
    {
      "name": "HTML/XML tags",
      "scope": [
