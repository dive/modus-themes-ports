  "tokenColors": [
    {
      "name": "Base text and variables",
      "scope": [
        "source",
        "text",
        "variable.other.readwrite",
        "punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#595959",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3548cf"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp.character-class",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#721045"
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.false",
        "constant.language.true",
        "keyword.other.unit",
        "keyword.other.unit.user-defined",
        "keyword.other.unit.suffix.floating-point"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#0000b0"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.word",
        "keyword.operator.new",
        "variable.language.super",
        "support.type.primitive",
        "storage.type",
        "storage.modifier",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#531ab6"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call.method",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#721045"
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "meta.function-call.constructor",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union"
      ],
      "settings": {
        "foreground": "#005f5f"
      }
    },
    {
      "name": "Types",
      "scope": [
        "meta.type",
        "meta.type-alias",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#005f5f"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "meta.enum variable.other.readwrite",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#3f578f"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "meta.property.object",
        "support.type.property-name",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#005e8b"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#0000b0"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#972500"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.this punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#7f0000"
      }
    },
    {
      "name": "Builtins and language constants",
      "scope": [
        "support.function.builtin",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#7f0000"
      }
    },
    {
      "name": "Template string variables",
      "scope": [
        "string.template variable",
        "string variable"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.decorator",
        "punctuation.definition.annotation",
        "meta.annotation variable.function",
        "meta.annotation variable.annotation.function",
        "meta.annotation punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#884900"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#6f5500"
      }
    },
    {
      "name": "HTML/XML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#0000b0"
      }
    },
    {
      "name": "HTML/XML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a0132f"
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "entity.name.tag.documentation",
        "entity.other.attribute-name.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#7f0000"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "keyword.other.import",
        "keyword.control.import",
        "keyword.control.export",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#6f5500"
      }
    },
    {
      "name": "Regex constructs",
      "scope": [
        "string.regexp",
        "keyword.other.back-reference",
        "keyword.operator.quantifier.regexp",
        "keyword.operator.alternation.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#3548cf"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup underline",
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup strikethrough",
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#7c318f"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#0000b0"
      }
    },
    {
      "name": "Markup blockquotes",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#193668"
      }
    },
    {
      "name": "Markup inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#006700"
      }
    },
    {
      "name": "Markup deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#aa2222"
      }
    },
    {
      "name": "Markup changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#655000"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#d00000"
      }
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#808000",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#000000",
    "variable.readonly": "#0000b0",
    "variable.defaultLibrary": "#7f0000",
