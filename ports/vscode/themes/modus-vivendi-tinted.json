  "tokenColors": [
    {
      "name": "Base text and variables",
      "scope": [
        "source",
        "text",
        "variable.other.readwrite",
        "punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.bracket"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#989898",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#79a8ff"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "string.regexp.character-class",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "name": "Numbers and booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.false",
        "constant.language.true",
        "keyword.other.unit",
        "keyword.other.unit.user-defined",
        "keyword.other.unit.suffix.floating-point"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "variable.other.constant",
        "entity.name.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#00bcff"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.word",
        "keyword.operator.new",
        "variable.language.super",
        "support.type.primitive",
        "storage.type",
        "storage.modifier",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#b6a0ff"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call.method",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#feacd0"
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "meta.function-call.constructor",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union"
      ],
      "settings": {
        "foreground": "#6ae4b9"
      }
    },
    {
      "name": "Types",
      "scope": [
        "meta.type",
        "meta.type-alias",
        "support.type",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#6ae4b9"
      }
    },
    {
      "name": "Enum members",
      "scope": [
        "meta.enum variable.other.readwrite",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#4ae2f0"
      }
    },
    {
      "name": "Object properties",
      "scope": [
        "meta.property.object",
        "support.type.property-name",
        "variable.object.property"
      ],
      "settings": {
        "foreground": "#00d3d0"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#00bcff"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#ff6b55"
      }
    },
    {
      "name": "this / self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.this punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#ef8386"
      }
    },
    {
      "name": "Builtins and language constants",
      "scope": [
        "support.function.builtin",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#ef8386"
      }
    },
    {
      "name": "Template string variables",
      "scope": [
        "string.template variable",
        "string variable"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "meta.annotation",
        "punctuation.decorator",
        "punctuation.definition.annotation",
        "meta.annotation variable.function",
        "meta.annotation variable.annotation.function",
        "meta.annotation punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#fec43f"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#d0bc00"
      }
    },
    {
      "name": "HTML/XML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#00bcff"
      }
    },
    {
      "name": "HTML/XML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ff7f86"
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "entity.name.tag.documentation",
        "entity.other.attribute-name.documentation",
        "comment.block.documentation"
      ],
      "settings": {
        "foreground": "#ef8386"
      }
    },
    {
      "name": "Preprocessor directives",
      "scope": [
        "keyword.control.directive",
        "keyword.other.import",
        "keyword.control.import",
        "keyword.control.export",
        "punctuation.definition.directive"
      ],
      "settings": {
        "foreground": "#d0bc00"
      }
    },
    {
      "name": "Regex constructs",
      "scope": [
        "string.regexp",
        "keyword.other.back-reference",
        "keyword.operator.quantifier.regexp",
        "keyword.operator.alternation.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#79a8ff"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup underline",
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup strikethrough",
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup inline code",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#caa6df"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#00bcff"
      }
    },
    {
      "name": "Markup blockquotes",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#c6daff"
      }
    },
    {
      "name": "Markup inserted",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#80e080"
      }
    },
    {
      "name": "Markup deleted",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#ff9095"
      }
    },
    {
      "name": "Markup changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#c0b05f"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "#ff5f5f"
      }
    },
    {
      "name": "Deprecated",
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#efef00",
        "fontStyle": "strikethrough"
      }
    }
