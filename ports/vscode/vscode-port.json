{
  "tool": "vscode",
  "distribution": "package",
  "package_root_rel": "ports/vscode/extension-root",
  "theme_dir_rel": "ports/vscode/extension-root/themes",
  "theme_ext": ".json",
  "output_path_template": "ports/vscode/extension-root/themes/{theme}.json",
  "template_path": "ports/vscode/theme.tmpl",
  "notice_style": "sidecar",
  "validate_json": true,
  "required_fields": [
    "name",
    "type",
    "colors",
    "tokenColors"
  ],
  "required_keys": [],
  "install_targets": [
    "$HOME/.vscode/extensions/modus-themes",
    "$HOME/.vscode-insiders/extensions/modus-themes"
  ],
  "config_locations": [
    "$HOME/Library/Application Support/Code/User/settings.json",
    "$HOME/.config/Code/User/settings.json"
  ]
}
