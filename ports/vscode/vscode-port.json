{
  "tool": "vscode",
  "theme_dir_rel": "ports/vscode/themes",
  "theme_ext": ".json",
  "output_path_template": "ports/vscode/themes/{theme}.json",
  "mapping_path": "mappings/vscode/default.json",
  "template_path": "ports/vscode/theme.tmpl",
  "template_format": "mini",
  "validate_json": true,
  "required_fields": [
    "name",
    "type",
    "colors",
    "tokenColors"
  ],
  "required_keys": [],
  "extra_install_dirs": [
    {
      "source_rel": "ports/vscode/extension-root",
      "dest_subdir": ".."
    }
  ],
  "install_targets": [
    "$HOME/.vscode/extensions/modus-themes/themes",
    "$HOME/.vscode-insiders/extensions/modus-themes/themes"
  ],
  "config_locations": [
    "$HOME/Library/Application Support/Code/User/settings.json",
    "$HOME/.config/Code/User/settings.json"
  ]
}
